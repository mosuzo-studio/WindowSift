---
import { ClientRouter } from 'astro:transitions';
import Header from '~/components/v3/Header.astro';
import Footer from '~/components/v3/Footer.astro';
import { identity } from '~/data/identity';
import { content } from '~/data/content';
import { switchLocalePath, type Lang } from '~/i18n/utils';
import '~/assets/styles/v3-home.css';
import '~/assets/styles/home-refresh.css';
import '~/assets/styles/product.css';
interface Props {
  lang: Lang;
  title: string;
  description?: string;
  noindex?: boolean;
}
const { lang, title, description = content[lang].summary, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, identity.domain).href;
const socialImage = identity.domain + '/social.png';
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {identity.name}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} />
    <link rel="canonical" href={canonical} />
    {
      (['en', 'zh-cn'] as const).map((code) => (
        <link rel="alternate" hreflang={code} href={identity.domain + switchLocalePath(Astro.url, code)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={identity.domain + switchLocalePath(Astro.url, 'en')} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} — ${identity.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={identity.name} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'zh_CN'} />
    <meta property="og:image" content={socialImage} />
    <meta name="theme-color" content="#ffffff" />
    <ClientRouter />
  </head>
  <body>
    <div class={`v3 v3-refresh product-${identity.slug}`}>
      <a class="skip-link" href="#main">{lang === 'en' ? 'Skip to content' : '跳到正文'}</a>
      <Header lang={lang} downloadUrl={identity.download ?? '/download'} homeRefresh />
      <main id="main"><slot /></main>
      <Footer lang={lang} homeRefresh />
    </div>
  </body>
</html>
