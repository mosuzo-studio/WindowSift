<script>
  const downloads = document.querySelector<HTMLElement>('[data-release-api]');
  if (downloads) {
    const { releaseApi, releaseRepo, releaseProduct } = downloads.dataset;
    const buttons = downloads.querySelectorAll<HTMLAnchorElement>('[data-release-package]');
    if (releaseApi) {
      fetch(releaseApi, { signal: AbortSignal.timeout(5000) })
        .then((response) => {
          if (!response.ok) throw new Error(`GitHub status ${response.status}`);
          return response.json();
        })
        .then((release) => {
          const tag = release.tag_name;
          if (typeof tag !== 'string' || !/^v?\d+\.\d+\.\d+$/i.test(tag) || !Array.isArray(release.assets)) return;
          for (const label of downloads.querySelectorAll('[data-release-version]')) {
            label.textContent = tag;
          }
          const version = tag.replace(/^v/i, '');
          for (const button of buttons) {
            const name = `${releaseProduct}-${version}-windows-x64-${button.dataset.releasePackage}`;
            const url = `${releaseRepo}/releases/download/${tag}/${name}`;
            if (release.assets.some((asset) => asset.name === name && asset.browser_download_url === url)) {
              button.href = url;
            }
          }
        })
        .catch(() => {
          // Keep the latest release page available if GitHub cannot be reached.
        });
    }
  }
</script>
